#!/usr/bin/env bash
# fcvm - build Firecracker microVMs from Ubuntu 26.04 and from OCI/Docker images.
. "$(dirname "$(readlink -f "$0")")/lib/common.sh"

usage() {
    cat <<EOF
usage: fcvm <command> [args]

Host (need sudo):
  host-setup                 install build/runtime packages, check KVM access
  net-up | net-down          create/remove bridge $NET_BRIDGE, $NET_TAPS tap devices and NAT

Build:
  firecracker                download the Firecracker release ($FC_VERSION) into bin/
  kernel [VERSION]           fetch latest $KERNEL_CHANNEL kernel from kernel.org, build a microVM vmlinux
  init                       build fc-init and the initramfs every VM boots with
  base [NAME]                build the Ubuntu 26.04 base image (default name: ubuntu-26.04)
  import REF [NAME]          image from Docker Hub / any registry, or local: docker-archive:F.tar,
                             oci:DIR, oci-archive:F.tar (or a path) -> VM image
  build [-t NAME] [-f FILE] [--build-arg K=V] [--no-cache] [--allow H,...] [CONTEXT]
                             build an image from a Dockerfile subset (cached per step)
  all                        firecracker + kernel + init + base

VMs:
  images [--all] [--json]    list images (--all: include the build cache). Types: app = runs
                             the image's command as the VM's single process; system =
                             boots systemd like a full machine
  create VM IMAGE [opts] [-- CMD...]
                             create a VM: IMAGE's disk is shared read-only, writes go to
                             a per-VM layer. opts: --vcpus N --mem MiB --disk SIZE
                             --copy (private full copy) -p [BIND:]HOST:GUEST (publish TCP)
                             -v VOLUME:/PATH[:ro] (named volume) --idle (app images: no
                             command, stays up for exec) --net none (no network)
                             --allow HOST,*.DOMAIN,@PRESET (egress allowlist via proxy)
  start [-a] VM              boot a VM in the background; -a attaches its console
  run IMAGE [-d] [opts] [-- CMD...]
                             throwaway VM, deleted when it stops. App images: attached
                             like docker run (exit code passed through; Ctrl-] detaches).
                             System images: drops into a shell; exit stops and deletes it
  stop VM                    ask the guest to shut down (Ctrl-Alt-Del), kill after a timeout
  console VM                 attach to the serial console (Ctrl-] detaches)
  logs [-f] VM               console output of the current or last boot
  exec [-i] [-t] [-u USER] [-w DIR] [-e K=V]... [--timeout S] VM CMD...
                             run a command in a running VM, like docker exec (over vsock);
                             USER is name|uid[:group|gid], default: the image's USER
  shell [-u USER] VM         interactive shell in a running VM (= exec -it VM bash|sh)
  ssh VM [args]              ssh root@VM (base images)
  cp SRC DST                 copy files in/out of a running VM (VM:PATH on one side)
  commit VM IMAGE            save a stopped VM's changes as a new image (a layer)
  squash IMAGE NEW           merge IMAGE's layers into one (same base image)
  prune                      delete the build cache and leftover build VMs
  inspect VM                 VM details as JSON
  ls [--all] [--json]        list VMs (--all: include build VMs)
  rm VM                      delete a VM
  rmi IMAGE                  delete an image
  egress VM [--allow H,...] [--deny H,...] [-f]
                             a restricted VM's allowlist and request log (changes are live)
  volume create NAME [SIZE] | ls [--json] | rm NAME
                             named volumes (persistent ext4 disks)
  mcp                        MCP server on stdio, for agents (see README)
EOF
}

cmd=${1:-help}; shift || true
case $cmd in
    host-setup)         exec "$FCVM_ROOT/lib/host-setup.sh" "$@" ;;
    net-up|net-down)    exec "$FCVM_ROOT/lib/net.sh" "${cmd#net-}" "$@" ;;
    firecracker)        exec "$FCVM_ROOT/lib/fetch-firecracker.sh" "$@" ;;
    kernel)             exec "$FCVM_ROOT/lib/build-kernel.sh" "$@" ;;
    init)               exec "$FCVM_ROOT/lib/build-init.sh" "$@" ;;
    base)               exec "$FCVM_ROOT/lib/build-base.sh" "$@" ;;
    import)             exec "$FCVM_ROOT/lib/import.sh" "$@" ;;
    build)              exec python3 "$FCVM_ROOT/lib/build.py" "$@" ;;
    all)
        "$FCVM_ROOT/lib/fetch-firecracker.sh"
        "$FCVM_ROOT/lib/build-kernel.sh"
        "$FCVM_ROOT/lib/build-init.sh"
        "$FCVM_ROOT/lib/build-base.sh" ;;
    images|create|start|run|stop|console|logs|ssh|exec|shell|ls|rm|inspect|commit|rmi|squash|prune|cp|volume|egress|_reap)
                        exec "$FCVM_ROOT/lib/vm.sh" "$cmd" "$@" ;;
    mcp)                exec python3 "$FCVM_ROOT/lib/mcp_server.py" "$@" ;;
    help|-h|--help)     usage ;;
    *)                  usage; exit 1 ;;
esac
